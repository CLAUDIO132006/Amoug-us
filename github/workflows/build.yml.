name: Compilar ELF para PS2

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    container: ps2dev/ps2dev:latest
    steps:
      - name: Instalar dependencias
        run: apk add build-base git

      - uses: actions/checkout@v4

      - name: Compilar
        run: make clean all

      - name: Subir ELF
        uses: actions/upload-artifact@v4
        with:
          name: sospechoso-elf
          path: sospechoso.elf
